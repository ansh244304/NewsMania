# Where the Express API lives. Leave as is for local development.
VITE_API_BASE_URL=http://localhost:5000/api

# Google Cloud console > APIs & Services > Credentials > Web OAuth
# client ID. Must match GOOGLE_CLIENT_ID in the backend .env.
# Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Must match STATIC_GK_MAX_FILE_MB on the backend. Used for client
# side upload validation only; the server enforces the real limit.
VITE_STATIC_GK_MAX_FILE_MB=25
