MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/newsmania?retryWrites=true&w=majority"
PORT=5000

# Gmail account + app password used by nodemailer to send the
# verification codes and the password reset link
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# Signs session tokens and password reset tokens. Generate with
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Optional: signs access tokens separately from reset tokens, so the
# two can be rotated independently. Leave unset to keep access tokens
# signed with JWT_SECRET.
JWT_ACCESS_SECRET=""

# Where the Vite app runs. Used to build the password reset link.
FRONTEND_URL="http://localhost:4000"

# Leave unset for local development. Any loopback origin
# (localhost or 127.0.0.1, any port) is then accepted, so the page
# works whichever spelling the browser used. Set a comma separated
# list in production to allow only your real domains.
#CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Google Cloud console > APIs & Services > Credentials > Web OAuth
# client ID. Must be the same value as VITE_GOOGLE_CLIENT_ID in the
# frontend. Leave blank to disable Google sign in.
GOOGLE_CLIENT_ID=

GEMINI_API_KEY=""
NEWS_API_KEY=""

# Static GK PDF library. Local storage is used by default and files
# are written to backend/uploads/static-gk. Keep this directory out
# of source control.
STATIC_GK_STORAGE_DRIVER="local"
STATIC_GK_MAX_FILE_MB=25
STATIC_GK_MAX_THUMBNAIL_MB=2
#STATIC_GK_UPLOAD_DIR="E:/secure/newsmania-static-gk"

# For private S3 or Cloudflare R2 storage, set the driver to "s3"
# and configure the bucket. The bucket should stay private; the API
# redirects authorised readers to short-lived signed URLs.
#STATIC_GK_S3_BUCKET="newsmania-static-gk"
#STATIC_GK_S3_REGION="auto"
#STATIC_GK_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#STATIC_GK_S3_PREFIX="static-gk"
#STATIC_GK_S3_ACCESS_KEY_ID=""
#STATIC_GK_S3_SECRET_ACCESS_KEY=""
#STATIC_GK_S3_FORCE_PATH_STYLE="false"
#STATIC_GK_SIGNED_URL_SECONDS=300
