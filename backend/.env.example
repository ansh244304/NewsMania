MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/newsmania?retryWrites=true&w=majority"
PORT=5000

# Gmail account + app password used by nodemailer to send the
# verification codes and the password reset link
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# Signs session tokens and password reset tokens. Generate with
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Optional: signs access tokens separately from reset tokens, so the
# two can be rotated independently. Leave unset to keep access tokens
# signed with JWT_SECRET.
JWT_ACCESS_SECRET=""

# Where the Vite app runs. Used to build the password reset link.
FRONTEND_URL="http://localhost:4000"

# Leave unset for local development. Any loopback origin
# (localhost or 127.0.0.1, any port) is then accepted, so the page
# works whichever spelling the browser used. Set a comma separated
# list in production to allow only your real domains.
#CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Google Cloud console > APIs & Services > Credentials > Web OAuth
# client ID. Must be the same value as VITE_GOOGLE_CLIENT_ID in the
# frontend. Leave blank to disable Google sign in.
GOOGLE_CLIENT_ID=

GEMINI_API_KEY=""
NEWS_API_KEY=""
